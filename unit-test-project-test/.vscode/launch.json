{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Helper API",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "request": "launch",
      "preLaunchTask": "npm: prestart",
      "type": "node",
      "runtimeExecutable": "nodemon",
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Get client assertion",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "request": "launch",
      "preLaunchTask": "npm: prestart",
      "type": "node",
      "program": "${workspaceFolder}/src/tools/get-client-assertion.js",
      "args": ["-e", "pprod"]
    },
